# Names only. Real values live in backend/.env locally (git-ignored) and in Railway Variables in production.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Supabase: Project Settings > Database > Connection string (Session pooler, port 5432)
DATABASE_URL=
# Your Netlify URL(s), comma separated
ALLOWED_ORIGINS=
TRUST_PROXY=1
# Railway volume mount path for evidence uploads
STORE_DIR=/data/store
