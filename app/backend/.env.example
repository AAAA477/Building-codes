# Copy this file to `.env` (same folder) and fill it in. `.env` is git-ignored; never commit or share it.
# Leave all keys empty to run in offline mode (deterministic fallback, no AI drafting).
# Test your setup from app/backend with:  .venv/Scripts/python.exe llm.py

# --- Azure OpenAI (used first if all three are set) ---
AZURE_OPENAI_API_KEY=
# Resource endpoint, e.g. https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# The DEPLOYMENT name you created in Azure (not the model family)
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Anthropic (used only if Azure is not configured) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Abuse protection (all optional; names only, defaults in ratelimit.py) ---
# ALLOWED_ORIGINS        comma-separated browser origins allowed by CORS (default: localhost/127.0.0.1 ports 5173-5177)
# TRUST_PROXY            set to 1 only behind a trusted reverse proxy, to honour X-Forwarded-For
# RL_GENERAL_PER_MIN     all /api requests per IP per minute (120)
# RL_LLM_PER_MIN         AI-backed endpoints per IP per minute (10)
# RL_LLM_PER_HOUR        AI-backed endpoints per IP per hour (100)
# RL_UPLOAD_PER_MIN      evidence uploads per IP per minute (20)
# RL_EXPORT_PER_MIN      exports / submission package per IP per minute (10)
# LLM_DAILY_CALL_CAP     global hosted-model calls per 24 h; beyond it the app answers offline (2000)
# LLM_PER_APP_CAP        hosted-model calls per application id per 24 h (60)
# LLM_MAX_PROMPT_CHARS   prompt text sent to the model is truncated to this length (8000)
# MAX_BODY_MB            largest accepted request body (30)
